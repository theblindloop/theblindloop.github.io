      "text": "def analytic_gold(scene: dict) -> str:\n    \"\"\"Select the marker nearest the declared circle center from visible fields.\"\"\"\n\n    cx, cy = scene[\"center\"]\n    markers = scene[\"markers\"]\n    winner = min(markers, key=lambda item: math.hypot(item[\"xy\"][0] - cx, item[\"xy\"][1] - cy))\n    return str(winner[\"color\"])"
